# Supabase (proyecto dev) — misma URL que backend/.env. La publishable key
# está pensada para ser pública (va al navegador), pero igual usamos
# placeholder acá por prolijidad — copiarla de Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here

# Backend NestJS (local: http://localhost:3001)
BACKEND_URL=http://localhost:3001
