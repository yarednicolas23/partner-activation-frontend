# Supabase (proyecto dev) — misma URL que backend/.env. La publishable key
# está pensada para ser pública (va al navegador), pero igual usamos
# placeholder acá por prolijidad — copiarla de Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here

# Backend NestJS (local: http://localhost:3001)
BACKEND_URL=http://localhost:3001

# Botón "Continuar com Google" en /login y /admin/login. "true" lo muestra
# (requiere el provider Google habilitado en Supabase → Authentication →
# Providers). En los deploys (Dockerfile / GitHub Actions) está en "true"
# por defecto; para ocultarlo allá, definir esta variable en "false".
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true
